//
// This file contains descriptions of the various LLVM instructions.  This is
// used as a central place for enumerating the different instructions and
// should eventually be the place to put comments about the instructions.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

// Provide definitions of macros so that users of this file do not have to
// define everything to use it...
//
#ifndef FIRST_TERM_INST
#define FIRST_TERM_INST(num)
#endif
#ifndef HANDLE_TERM_INST
#ifndef HANDLE_INST
#define HANDLE_TERM_INST(num, opcode, Class)
#else
#define HANDLE_TERM_INST(num, opcode, Class) HANDLE_INST(num, opcode, Class)
#endif
#endif
#ifndef LAST_TERM_INST
#define LAST_TERM_INST(num)
#endif

#ifndef FIRST_UNARY_INST
#define FIRST_UNARY_INST(num)
#endif
#ifndef HANDLE_UNARY_INST
#ifndef HANDLE_INST
#define HANDLE_UNARY_INST(num, opcode, instclass)
#else
#define HANDLE_UNARY_INST(num, opcode, Class) HANDLE_INST(num, opcode, Class)
#endif
#endif
#ifndef LAST_UNARY_INST
#define LAST_UNARY_INST(num)
#endif

#ifndef FIRST_BINARY_INST
#define FIRST_BINARY_INST(num)
#endif
#ifndef HANDLE_BINARY_INST
#ifndef HANDLE_INST
#define HANDLE_BINARY_INST(num, opcode, instclass)
#else
#define HANDLE_BINARY_INST(num, opcode, Class) HANDLE_INST(num, opcode, Class)
#endif
#endif
#ifndef LAST_BINARY_INST
#define LAST_BINARY_INST(num)
#endif

#ifndef FIRST_MEMORY_INST
#define FIRST_MEMORY_INST(num)
#endif
#ifndef HANDLE_MEMORY_INST
#ifndef HANDLE_INST
#define HANDLE_MEMORY_INST(num, opcode, Class)
#else
#define HANDLE_MEMORY_INST(num, opcode, Class) HANDLE_INST(num, opcode, Class)
#endif
#endif
#ifndef LAST_MEMORY_INST
#define LAST_MEMORY_INST(num)
#endif

#ifndef FIRST_CAST_INST
#define FIRST_CAST_INST(num)
#endif
#ifndef HANDLE_CAST_INST
#ifndef HANDLE_INST
#define HANDLE_CAST_INST(num, opcode, Class)
#else
#define HANDLE_CAST_INST(num, opcode, Class) HANDLE_INST(num, opcode, Class)
#endif
#endif
#ifndef LAST_CAST_INST
#define LAST_CAST_INST(num)
#endif

#ifndef FIRST_FUNCLETPAD_INST
#define FIRST_FUNCLETPAD_INST(num)
#endif
#ifndef HANDLE_FUNCLETPAD_INST
#ifndef HANDLE_INST
#define HANDLE_FUNCLETPAD_INST(num, opcode, Class)
#else
#define HANDLE_FUNCLETPAD_INST(num, opcode, Class) HANDLE_INST(num, opcode, Class)
#endif
#endif
#ifndef LAST_FUNCLETPAD_INST
#define LAST_FUNCLETPAD_INST(num)
#endif

#ifndef FIRST_OTHER_INST
#define FIRST_OTHER_INST(num)
#endif
#ifndef HANDLE_OTHER_INST
#ifndef HANDLE_INST
#define HANDLE_OTHER_INST(num, opcode, Class)
#else
#define HANDLE_OTHER_INST(num, opcode, Class) HANDLE_INST(num, opcode, Class)
#endif
#endif
#ifndef LAST_OTHER_INST
#define LAST_OTHER_INST(num)
#endif

#ifndef HANDLE_USER_INST
#define HANDLE_USER_INST(num, opc, Class) HANDLE_OTHER_INST(num, opc, Class)
#endif

// Terminator Instructions - These instructions are used to terminate a basic
// block of the program.   Every basic block must end with one of these
// instructions for it to be a well formed basic block.
//
 FIRST_TERM_INST  ( 1)
/// Visit a ret terminator that returns from the current function.
/// \param I The return instruction being visited.
HANDLE_TERM_INST  ( 1, Ret           , ReturnInst)
/// Visit an unconditional branch to a single successor.
/// \param I The unconditional branch instruction being visited.
HANDLE_TERM_INST  ( 2, UncondBr      , UncondBrInst)
/// Visit a conditional branch that chooses between two successors.
/// \param I The conditional branch instruction being visited.
HANDLE_TERM_INST  ( 3, CondBr        , CondBrInst)
/// Visit a switch that dispatches on an integer value.
/// \param I The switch instruction being visited.
HANDLE_TERM_INST  ( 4, Switch        , SwitchInst)
/// Visit an indirect branch through an address operand.
/// \param I The indirect branch instruction being visited.
HANDLE_TERM_INST  ( 5, IndirectBr    , IndirectBrInst)
/// Visit an invoke that calls a function with an exceptional continuation.
/// \param I The invoke instruction being visited.
HANDLE_TERM_INST  ( 6, Invoke        , InvokeInst)
/// Visit a resume that continues unwinding of an exception.
/// \param I The resume instruction being visited.
HANDLE_TERM_INST  ( 7, Resume        , ResumeInst)
/// Visit an unreachable marker for code that must never execute.
/// \param I The unreachable instruction being visited.
HANDLE_TERM_INST  ( 8, Unreachable   , UnreachableInst)
/// Visit a cleanupret that exits a cleanup funclet pad.
/// \param I The cleanup return instruction being visited.
HANDLE_TERM_INST  ( 9, CleanupRet    , CleanupReturnInst)
/// Visit a catchret that exits a catch funclet pad.
/// \param I The catch return instruction being visited.
HANDLE_TERM_INST  (10, CatchRet      , CatchReturnInst)
/// Visit a catchswitch that dispatches among catch pads.
/// \param I The catchswitch instruction being visited.
HANDLE_TERM_INST  (11, CatchSwitch   , CatchSwitchInst)
/// Visit a callbr call-site terminator with additional transfer labels.
/// \param I The callbr instruction being visited.
HANDLE_TERM_INST  (12, CallBr        , CallBrInst)
  LAST_TERM_INST  (12)

// Standard unary operators...
 FIRST_UNARY_INST(13)
/// Create or visit a floating-point negation (fneg) instruction.
/// \param I The fneg instruction being visited.
/// \param V Operand to negate.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_UNARY_INST(13, FNeg  , FPUnaryOperator)
  LAST_UNARY_INST(13)

// Standard binary operators...
 FIRST_BINARY_INST(14)
/// Create or visit an integer addition (add) instruction.
/// \param I The add instruction being visited.
/// \param V1 Left-hand operand.
/// \param V2 Right-hand operand.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(14, Add  , BinaryOperator)
/// Create or visit a floating-point addition (fadd) instruction.
/// \param I The fadd instruction being visited.
/// \param V1 Left-hand operand.
/// \param V2 Right-hand operand.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(15, FAdd , FPBinaryOperator)
/// Create or visit an integer subtraction (sub) instruction.
/// \param I The sub instruction being visited.
/// \param V1 Left-hand operand.
/// \param V2 Right-hand operand.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(16, Sub  , BinaryOperator)
/// Create or visit a floating-point subtraction (fsub) instruction.
/// \param I The fsub instruction being visited.
/// \param V1 Left-hand operand.
/// \param V2 Right-hand operand.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(17, FSub , FPBinaryOperator)
/// Create or visit an integer multiplication (mul) instruction.
/// \param I The mul instruction being visited.
/// \param V1 Left-hand operand.
/// \param V2 Right-hand operand.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(18, Mul  , BinaryOperator)
/// Create or visit a floating-point multiplication (fmul) instruction.
/// \param I The fmul instruction being visited.
/// \param V1 Left-hand operand.
/// \param V2 Right-hand operand.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(19, FMul , FPBinaryOperator)
/// Create or visit an unsigned integer division (udiv) instruction.
/// \param I The udiv instruction being visited.
/// \param V1 Left-hand operand (dividend).
/// \param V2 Right-hand operand (divisor).
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(20, UDiv , BinaryOperator)
/// Create or visit a signed integer division (sdiv) instruction.
/// \param I The sdiv instruction being visited.
/// \param V1 Left-hand operand (dividend).
/// \param V2 Right-hand operand (divisor).
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(21, SDiv , BinaryOperator)
/// Create or visit a floating-point division (fdiv) instruction.
/// \param I The fdiv instruction being visited.
/// \param V1 Left-hand operand (dividend).
/// \param V2 Right-hand operand (divisor).
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(22, FDiv , FPBinaryOperator)
/// Create or visit an unsigned integer remainder (urem) instruction.
/// \param I The urem instruction being visited.
/// \param V1 Left-hand operand (dividend).
/// \param V2 Right-hand operand (divisor).
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(23, URem , BinaryOperator)
/// Create or visit a signed integer remainder (srem) instruction.
/// \param I The srem instruction being visited.
/// \param V1 Left-hand operand (dividend).
/// \param V2 Right-hand operand (divisor).
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(24, SRem , BinaryOperator)
/// Create or visit a floating-point remainder (frem) instruction.
/// \param I The frem instruction being visited.
/// \param V1 Left-hand operand (dividend).
/// \param V2 Right-hand operand (divisor).
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(25, FRem , FPBinaryOperator)

// Logical operators (integer operands)
/// Create or visit a logical left-shift (shl) instruction.
/// \param I The shl instruction being visited.
/// \param V1 Value to shift.
/// \param V2 Shift amount.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(26, Shl  , BinaryOperator)
/// Create or visit a logical right-shift (lshr) instruction.
/// \param I The lshr instruction being visited.
/// \param V1 Value to shift.
/// \param V2 Shift amount.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(27, LShr , BinaryOperator)
/// Create or visit an arithmetic right-shift (ashr) instruction.
/// \param I The ashr instruction being visited.
/// \param V1 Value to shift.
/// \param V2 Shift amount.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(28, AShr , BinaryOperator)
/// Create or visit a bitwise AND (and) instruction.
/// \param I The and instruction being visited.
/// \param V1 Left-hand operand.
/// \param V2 Right-hand operand.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(29, And  , BinaryOperator)
/// Create or visit a bitwise OR (or) instruction.
/// \param I The or instruction being visited.
/// \param V1 Left-hand operand.
/// \param V2 Right-hand operand.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(30, Or   , BinaryOperator)
/// Create or visit a bitwise XOR (xor) instruction.
/// \param I The xor instruction being visited.
/// \param V1 Left-hand operand.
/// \param V2 Right-hand operand.
/// \param Name Optional name for the new instruction.
/// \param InsertBefore Optional insertion point for the new instruction.
HANDLE_BINARY_INST(31, Xor  , BinaryOperator)
  LAST_BINARY_INST(31)

// Memory operators...
 FIRST_MEMORY_INST(32)
/// Visit an alloca that allocates stack memory.
/// \param I The alloca instruction being visited.
HANDLE_MEMORY_INST(32, Alloca, AllocaInst)
/// Visit a load that reads from memory.
/// \param I The load instruction being visited.
HANDLE_MEMORY_INST(33, Load  , LoadInst  )
/// Visit a store that writes a value to memory.
/// \param I The store instruction being visited.
HANDLE_MEMORY_INST(34, Store , StoreInst )
/// Visit a getelementptr that computes an address within an aggregate.
/// \param I The getelementptr instruction being visited.
HANDLE_MEMORY_INST(35, GetElementPtr, GetElementPtrInst)
/// Visit a fence that orders memory operations.
/// \param I The fence instruction being visited.
HANDLE_MEMORY_INST(36, Fence , FenceInst )
/// Visit an atomic compare-and-exchange (cmpxchg) instruction.
/// \param I The atomiccmpxchg instruction being visited.
HANDLE_MEMORY_INST(37, AtomicCmpXchg , AtomicCmpXchgInst )
/// Visit an atomic read-modify-write (atomicrmw) instruction.
/// \param I The atomicrmw instruction being visited.
HANDLE_MEMORY_INST(38, AtomicRMW , AtomicRMWInst )
  LAST_MEMORY_INST(38)

// Cast operators ...
// NOTE: The order matters here because CastInst::isEliminableCastPair
// NOTE: (see Instructions.cpp) encodes a table based on this ordering.
 FIRST_CAST_INST(39)
/// Visit a trunc that narrows an integer value.
/// \param I The trunc instruction being visited.
HANDLE_CAST_INST(39, Trunc   , TruncInst   )
/// Visit a zext that zero-extends an integer value.
/// \param I The zext instruction being visited.
HANDLE_CAST_INST(40, ZExt    , ZExtInst    )
/// Visit a sext that sign-extends an integer value.
/// \param I The sext instruction being visited.
HANDLE_CAST_INST(41, SExt    , SExtInst    )
/// Visit an fptoui that converts floating-point to unsigned integer.
/// \param I The fptoui instruction being visited.
HANDLE_CAST_INST(42, FPToUI  , FPToUIInst  )
/// Visit an fptosi that converts floating-point to signed integer.
/// \param I The fptosi instruction being visited.
HANDLE_CAST_INST(43, FPToSI  , FPToSIInst  )
/// Visit a uitofp that converts unsigned integer to floating-point.
/// \param I The uitofp instruction being visited.
HANDLE_CAST_INST(44, UIToFP  , UIToFPInst  )
/// Visit a sitofp that converts signed integer to floating-point.
/// \param I The sitofp instruction being visited.
HANDLE_CAST_INST(45, SIToFP  , SIToFPInst  )
/// Visit an fptrunc that narrows a floating-point value.
/// \param I The fptrunc instruction being visited.
HANDLE_CAST_INST(46, FPTrunc , FPTruncInst )
/// Visit an fpext that extends a floating-point value.
/// \param I The fpext instruction being visited.
HANDLE_CAST_INST(47, FPExt   , FPExtInst   )
/// Visit a ptrtoint that bitcasts a pointer to an integer.
/// \param I The ptrtoint instruction being visited.
HANDLE_CAST_INST(48, PtrToInt, PtrToIntInst)
/// Visit a ptrtoaddr that converts a pointer to an address integer.
/// \param I The ptrtoaddr instruction being visited.
HANDLE_CAST_INST(49, PtrToAddr, PtrToAddrInst)
/// Visit an inttoptr that converts an integer to a pointer.
/// \param I The inttoptr instruction being visited.
HANDLE_CAST_INST(50, IntToPtr, IntToPtrInst)
/// Visit a bitcast that reinterprets bits between types of equal size.
/// \param I The bitcast instruction being visited.
HANDLE_CAST_INST(51, BitCast , BitCastInst )
/// Visit an addrspacecast that changes a pointer's address space.
/// \param I The addrspacecast instruction being visited.
HANDLE_CAST_INST(52, AddrSpaceCast, AddrSpaceCastInst)
  LAST_CAST_INST(52)

 FIRST_FUNCLETPAD_INST(53)
/// Visit a cleanuppad that begins a cleanup funclet.
/// \param I The cleanuppad instruction being visited.
HANDLE_FUNCLETPAD_INST(53, CleanupPad, CleanupPadInst)
/// Visit a catchpad that begins a catch funclet.
/// \param I The catchpad instruction being visited.
HANDLE_FUNCLETPAD_INST(54, CatchPad  , CatchPadInst)
  LAST_FUNCLETPAD_INST(54)

// Other operators...
 FIRST_OTHER_INST(55)
/// Visit an icmp integer comparison instruction.
/// \param I The icmp instruction being visited.
HANDLE_OTHER_INST(55, ICmp   , ICmpInst   )
/// Visit an fcmp floating-point comparison instruction.
/// \param I The fcmp instruction being visited.
HANDLE_OTHER_INST(56, FCmp   , FCmpInst   )
/// Visit a phi node that merges values from predecessor blocks.
/// \param I The phi instruction being visited.
HANDLE_OTHER_INST(57, PHI    , PHINode    )
/// Visit a call that invokes a function.
/// \param I The call instruction being visited.
HANDLE_OTHER_INST(58, Call   , CallInst   )
/// Visit a select that chooses one of two values by a condition.
/// \param I The select instruction being visited.
HANDLE_OTHER_INST(59, Select , SelectInst )
/// Visit a UserOp1 placeholder that may be used internally in a pass.
/// \param I The UserOp1 instruction being visited.
HANDLE_USER_INST (60, UserOp1, Instruction)
/// Visit a UserOp2 placeholder that is internal to passes only.
/// \param I The UserOp2 instruction being visited.
HANDLE_USER_INST (61, UserOp2, Instruction)
/// Visit a vaarg that reads the next variable argument.
/// \param I The vaarg instruction being visited.
HANDLE_OTHER_INST(62, VAArg  , VAArgInst  )
/// Visit an extractelement that pulls one element from a vector.
/// \param I The extractelement instruction being visited.
HANDLE_OTHER_INST(63, ExtractElement, ExtractElementInst)
/// Visit an insertelement that inserts one element into a vector.
/// \param I The insertelement instruction being visited.
HANDLE_OTHER_INST(64, InsertElement, InsertElementInst)
/// Visit a shufflevector that permutes elements from two vectors.
/// \param I The shufflevector instruction being visited.
HANDLE_OTHER_INST(65, ShuffleVector, ShuffleVectorInst)
/// Visit an extractvalue that pulls a field from an aggregate.
/// \param I The extractvalue instruction being visited.
HANDLE_OTHER_INST(66, ExtractValue, ExtractValueInst)
/// Visit an insertvalue that inserts a field into an aggregate.
/// \param I The insertvalue instruction being visited.
HANDLE_OTHER_INST(67, InsertValue, InsertValueInst)
/// Visit a landingpad that receives an exception in an invoke unwind edge.
/// \param I The landingpad instruction being visited.
HANDLE_OTHER_INST(68, LandingPad, LandingPadInst)
/// Visit a freeze that replaces undef or poison with a fixed value.
/// \param I The freeze instruction being visited.
HANDLE_OTHER_INST(69, Freeze, FreezeInst)
  LAST_OTHER_INST(69)

#undef  FIRST_TERM_INST
#undef HANDLE_TERM_INST
#undef   LAST_TERM_INST

#undef  FIRST_UNARY_INST
#undef HANDLE_UNARY_INST
#undef   LAST_UNARY_INST

#undef  FIRST_BINARY_INST
#undef HANDLE_BINARY_INST
#undef   LAST_BINARY_INST

#undef  FIRST_MEMORY_INST
#undef HANDLE_MEMORY_INST
#undef   LAST_MEMORY_INST

#undef  FIRST_CAST_INST
#undef HANDLE_CAST_INST
#undef   LAST_CAST_INST

#undef  FIRST_FUNCLETPAD_INST
#undef HANDLE_FUNCLETPAD_INST
#undef   LAST_FUNCLETPAD_INST

#undef  FIRST_OTHER_INST
#undef HANDLE_OTHER_INST
#undef   LAST_OTHER_INST

#undef HANDLE_USER_INST

#ifdef HANDLE_INST
#undef HANDLE_INST
#endif
